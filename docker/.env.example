# super-silly environment — copy to .env in this directory and edit:
#   cp .env.example .env
#
# Compose auto-discovers .env next to the compose files, so no flags needed:
#   docker compose -f docker/docker-compose.yml up -d --build
# Dev override (12B primary on <=16GB VRAM GPUs, port 8001):
#   docker compose -f docker/docker-compose.yml -f docker/compose.dev.yml up -d --build

# ---- networking ----
# External port SillyTavern is published on (host side of the mapping).
# Dev override uses SUPERSILLY_DEV_PORT (default 8001) so both can run at once.
SUPERSILLY_PORT=8000

# ---- server deployment (docker/compose.server.yml only) ----
# Host base directory for the three bind mounts (config/ data/ ollama/).
# Point it at a ZFS dataset for snapshots; on TrueNAS something like:
#   SUPERSILLY_BASE=/mnt/tank/apps/supersilly
# Unset, the server compose defaults to ./server-data next to the compose file
# — fine for a scratch test, wrong for a real server.
#SUPERSILLY_BASE=/mnt/tank/apps/supersilly

# ---- lifecycle ----
# Do characters start STOPPED on every server boot? true (default) is the safe
# dev choice — a rebuild never wakes everyone unattended. On an unattended
# server you likely want false: characters survive restarts/updates running.
# Overrides the engine setting from the panel at boot, every boot.
#AUTOLIFE_START_STOPPED=false

# ---- web UI security (SillyTavern basic auth via its SILLYTAVERN_* env overrides) ----
# The seed config is LAN-open (no auth). If the box is reachable beyond your
# trusted LAN, set these — the web UI then requires the credentials.
#SILLYTAVERN_BASICAUTHMODE=true
#SILLYTAVERN_BASICAUTHUSER_USERNAME=you
#SILLYTAVERN_BASICAUTHUSER_PASSWORD=change-me

# ---- models ----
# Optional: leave both commented out to use the built-in defaults.
#   - main compose file:    Dark-Scarlett-27B Q4_K_M (Tesla P40 24GB)
#   - docker/compose.dev.yml: Dark-Desires-12B Q4_K_M (RTX 5060 16GB) as primary
# Setting OLLAMA_MODEL here overrides BOTH defaults, including the dev override.
#OLLAMA_MODEL=hf.co/ReadyArt/Dark-Scarlett-27B-v2.0-GGUF:Q4_K_M
#OLLAMA_FALLBACK_MODEL=hf.co/ReadyArt/Dark-Desires-12B-v1.0-GGUF:Q4_K_M

# Embedding model for character long-term memory (RAG). Auto-pulled on first
# use (~274 MB). Changing it later rebuilds all memory indexes.
#OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- telegram ----
# Bot token from @BotFather (https://t.me/BotFather). Leave empty to configure
# later via the Autolife panel in SillyTavern instead (stored server-side).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to talk to the bot. Fail-closed:
# everyone not listed is ignored. Get your id from https://t.me/userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- generation backend ----
# 'ollama' (default) or 'llamacpp'. Switch to llamacpp to run Qwen3.5 models
# (Dark-Scarlett — Ollama can't load that architecture) and to use the
# top_n_sigma/XTC-capable sampler set. Models keep the same
# hf.co/Owner/Repo:Tag names either way; GGUFs download on demand with a
# progress bar (panel or /model pull) into the models volume.
#AUTOLIFE_BACKEND=llamacpp

# llama.cpp knobs (rarely needed — the container defaults are right):
#   LLAMACPP_BIN    llama-server binary (default: /usr/local/bin/llama-server)
#   LLAMACPP_MODELS GGUF storage dir (default: /models volume)
#   LLAMACPP_PORT / LLAMACPP_EMBED_PORT  internal ports (11440/11441)
#   LLAMACPP_CTX    context window at server launch (default: 8192; also
#                   settable per-instance from the panel's num_ctx setting)
#LLAMACPP_BIN=/usr/local/bin/llama-server
#LLAMACPP_MODELS=/models
