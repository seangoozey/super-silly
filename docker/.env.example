# super-silly environment — copy to .env and edit:
#   cp .env.example .env
#
# Run with (env file lives at the repo root, one level above the compose file):
#   docker compose --env-file .env -f docker/docker-compose.yml up -d --build
# Dev override (12B primary on <=16GB VRAM GPUs, port 8001):
#   docker compose --env-file .env -f docker/docker-compose.yml -f docker/compose.dev.yml up -d --build

# ---- networking ----
# External port SillyTavern is published on (host side of the mapping).
# Dev override uses SUPERSILLY_DEV_PORT (default 8001) so both can run at once.
SUPERSILLY_PORT=8000

# ---- models ----
# Optional: leave both commented out to use the built-in defaults.
#   - main compose file:    Dark-Scarlett-27B Q4_K_M (Tesla P40 24GB)
#   - docker/compose.dev.yml: Dark-Desires-12B Q4_K_M (RTX 5060 16GB) as primary
# Setting OLLAMA_MODEL here overrides BOTH defaults, including the dev override.
#OLLAMA_MODEL=hf.co/ReadyArt/Dark-Scarlett-27B-v2.0-GGUF:Q4_K_M
#OLLAMA_FALLBACK_MODEL=hf.co/ReadyArt/Dark-Desires-12B-v1.0-GGUF:Q4_K_M

# ---- telegram ----
# Bot token from @BotFather (https://t.me/BotFather). Leave empty to configure
# later via the Autolife panel in SillyTavern instead (stored server-side).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to talk to the bot. Fail-closed:
# everyone not listed is ignored. Get your id from https://t.me/userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
